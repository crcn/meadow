FROM rust:1.84-bookworm

RUN cargo install cargo-watch

WORKDIR /app

COPY Cargo.toml Cargo.lock* ./
COPY modules/learning-core/Cargo.toml modules/learning-core/Cargo.toml
COPY modules/learning-domains/Cargo.toml modules/learning-domains/Cargo.toml
COPY modules/learning-server/Cargo.toml modules/learning-server/Cargo.toml
COPY modules/learning-web/Cargo.toml modules/learning-web/Cargo.toml

# Create dummy src files for dependency caching
RUN mkdir -p modules/learning-core/src && echo "pub fn stub() {}" > modules/learning-core/src/lib.rs && \
    mkdir -p modules/learning-domains/src && echo "pub fn stub() {}" > modules/learning-domains/src/lib.rs && \
    mkdir -p modules/learning-server/src && echo "fn main() {}" > modules/learning-server/src/main.rs && \
    mkdir -p modules/learning-web/src && echo "fn main() {}" > modules/learning-web/src/main.rs

RUN cargo build 2>/dev/null || true

COPY . .

CMD ["cargo", "watch", "-x", "run -p learning-server", "-w", "modules"]
