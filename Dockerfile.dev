FROM rust:latest

RUN cargo install cargo-watch --locked

WORKDIR /app

COPY Cargo.toml Cargo.lock* ./
COPY modules/ai-client/Cargo.toml modules/ai-client/Cargo.toml
COPY modules/apify-client/Cargo.toml modules/apify-client/Cargo.toml
COPY modules/twilio-rs/Cargo.toml modules/twilio-rs/Cargo.toml
COPY modules/learning-core/Cargo.toml modules/learning-core/Cargo.toml
COPY modules/learning-server/Cargo.toml modules/learning-server/Cargo.toml

# Create dummy src files for dependency caching
RUN mkdir -p modules/ai-client/src && echo "pub fn stub() {}" > modules/ai-client/src/lib.rs && \
    mkdir -p modules/apify-client/src && echo "pub fn stub() {}" > modules/apify-client/src/lib.rs && \
    mkdir -p modules/twilio-rs/src && echo "pub fn stub() {}" > modules/twilio-rs/src/lib.rs && \
    mkdir -p modules/learning-core/src && echo "pub fn stub() {}" > modules/learning-core/src/lib.rs && \
    mkdir -p modules/learning-server/src && echo "fn main() {}" > modules/learning-server/src/main.rs && \
    mkdir -p migrations

RUN cargo build 2>/dev/null || true

COPY . .

ENV DOCKER_ENV=1

CMD ["cargo", "watch", "-x", "run -p learning-server", "-w", "modules"]
